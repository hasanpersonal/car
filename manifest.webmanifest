{
  "id": "./",
  "name": "NEON DRIVE - Multiplayer Racing",
  "short_name": "NEON DRIVE",
  "description": "A neon 3D multiplayer racing game with realistic driving physics, solo practice, quick matches, private rooms, nitro and abilities.",
